MAPA_PLANTILLAS = {
    "README-libro.md": "README.md",
    "APUNTES.md": "APUNTES.md",
    "BITACORA.md": "BITACORA.md",
    "ESTRUCTURA.md": "ESTRUCTURA.md",
    "GLOSARIO.md": "GLOSARIO.md",
    "PERSONAS.md": "PERSONAS.md",
    "FUENTES.md": "FUENTES.md",
    "CRONOLOGIA.md": "CRONOLOGIA.md",
    "MANUSCRITO-00-LEEME.md": "MANUSCRITO/00-LEEME.md",
    "SINOPSIS-00-indice.md": "SINOPSIS/00-indice.md",
    "ESTUDIOS-00-indice.md": "ESTUDIOS/00-indice.md",
}


def cmd_init(args):
    destino = Path(args.directorio).expanduser().resolve()
    if destino.exists() and any(destino.iterdir()) and not args.forzar:
        raise NKError("%s no está vacío (usa --forzar)" % destino)
    kit = Path(__file__).resolve().parent.parent
    destino.mkdir(parents=True, exist_ok=True)

    for nombre in ("METODO", "PROMPTS", "PLANTILLAS", "EJEMPLO", "pruebas"):
        origen = kit / nombre
        if origen.is_dir():
            shutil.copytree(origen, destino / nombre, dirs_exist_ok=True,
                            ignore=shutil.ignore_patterns("__pycache__", "*.pyc",
                                                          "estado.json", "salida.epub"))
    for nombre in ("AGENTS.md", "PROTOCOLO.md", "PUBLICAR.md", "install.sh", "VERSION",
                   "LICENSE-CODIGO", "LICENSE-TEXTO"):
        origen = kit / nombre
        if origen.is_file():
            shutil.copy2(origen, destino / nombre)
    (destino / "bin").mkdir(exist_ok=True)
    shutil.copy2(Path(__file__).resolve(), destino / "bin" / "nk")
    (destino / "bin" / "nk").chmod(0o755)

    for origen, rel in MAPA_PLANTILLAS.items():
        o = kit / "PLANTILLAS" / origen
        if o.is_file():
            (destino / rel).parent.mkdir(parents=True, exist_ok=True)
            texto = o.read_text(encoding="utf-8")
            texto = (texto.replace("{{TITULO}}", args.titulo)
                          .replace("{{AUTOR}}", args.autor or "")
                          .replace("{{FUENTE}}", args.fuente or ""))
            (destino / rel).write_text(texto, encoding="utf-8")

    partes = []
    per = max(1, args.capitulos // max(1, args.partes))
    for i in range(args.partes):
        pid = "I" if i == 0 else ("II" if i == 1 else str(i + 1))
        partes.append({
            "id": pid,
            "titulo": "Parte %s" % pid,
            "dir": "%02d-parte-%s" % (i + 1, pid),
            "capitulos": per,
        })
    man = {
        "kit": VERSION,
        "libro": {
            "titulo": args.titulo,
            "autor": args.autor or "",
            "fuente": args.fuente or "",
            "idioma": "es-ES",
            "objetivo_palabras": args.objetivo,
            "salida": "salida",
        },
        "partes": partes,
        "presupuesto": {"tolerancia": 0.20},
        "conteo": {"metodo": "palabras"},
        "verificacion": {"prohibiciones": [], "sin_nombres": False,
                         "nombres_permitidos": []},
    }
    (destino / "libro.json").write_text(
        json.dumps(man, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    print("Obra creada en %s (%s × %s, %d palabras objetivo)." % (
        destino, plural(args.partes, "parte", "partes"),
        plural(per, "capítulo", "capítulos"), args.objetivo))
    print("Siguiente: revisa libro.json y APUNTES.md, luego `bin/nk andamiaje`.")
    return 0


# --------------------------------------------------------------------------- #
# paquete: artefactos publicables (tarball, hashes, instalador)
# --------------------------------------------------------------------------- #

INCLUIR_PAQUETE = [
    "AGENTS.md", "PROTOCOLO.md", "README.md", "install.sh", "VERSION",
    "LICENSE-CODIGO", "LICENSE-TEXTO", "bin", "METODO", "PROMPTS",
    "PLANTILLAS", "EJEMPLO", "pruebas",
]
EXCLUIR_PAQUETE = {"__pycache__", ".git", "dist", "estado.json", "salida.epub"}


def ficheros_paquete(kit):
    elegidos = []
    for nombre in INCLUIR_PAQUETE:
        p = kit / nombre
        if p.is_file():
            elegidos.append(p)
        elif p.is_dir():
            for f in p.rglob("*"):
                if not f.is_file() or f.suffix == ".pyc":
                    continue
                if set(f.relative_to(kit).parts) & EXCLUIR_PAQUETE:
                    continue
                elegidos.append(f)
    return sorted(set(elegidos), key=lambda x: str(x.relative_to(kit)))


def _tar_gz_determinista(kit, ficheros, destino, nombre_raiz):
    """Tarball reproducible: mismo contenido, mismos bytes (mtime 0, sin uid/gid)."""
    bruto = io.BytesIO()
    with tarfile.open(fileobj=bruto, mode="w", format=tarfile.PAX_FORMAT) as tf:
        for f in ficheros:
            datos = f.read_bytes()
            info = tarfile.TarInfo("%s/%s" % (nombre_raiz, f.relative_to(kit).as_posix()))
            info.size = len(datos)
            info.mtime = 0
            info.uid = info.gid = 0
            info.uname = info.gname = ""
            info.mode = 0o755 if os.access(f, os.X_OK) else 0o644
            tf.addfile(info, io.BytesIO(datos))
    with open(destino, "wb") as fh:
        with gzip.GzipFile(fileobj=fh, mode="wb", mtime=0) as gz:
            gz.write(bruto.getvalue())


def _sha256(ruta):
    h = hashlib.sha256()
    with open(ruta, "rb") as fh:
        for trozo in iter(lambda: fh.read(65536), b""):
            h.update(trozo)
    return h.hexdigest()


def cmd_paquete(args):
    kit = Path(__file__).resolve().parent.parent
    destino = Path(args.destino or (kit / "dist"))
    destino.mkdir(parents=True, exist_ok=True)
    version = (kit / "VERSION").read_text(encoding="utf-8").strip() \
        if (kit / "VERSION").is_file() else VERSION
    ficheros = ficheros_paquete(kit)
    faltan = [n for n in ("install.sh", "PROTOCOLO.md", "AGENTS.md")
              if not (kit / n).is_file()]
    if faltan:
        raise NKError("faltan ficheros para empaquetar: %s" % ", ".join(faltan))

    for viejo in destino.glob("novela-kit-*.tar.gz"):
        viejo.unlink()
    nombre = "novela-kit-%s" % version
    tarball = destino / (nombre + ".tar.gz")
    _tar_gz_determinista(kit, ficheros, tarball, nombre)

    (destino / "FICHEROS.txt").write_text(
        "".join("%s  %s\n" % (_sha256(f), f.relative_to(kit).as_posix()) for f in ficheros),
        encoding="utf-8")

    sueltos = [tarball]
    for n in ("install.sh", "PROTOCOLO.md", "PUBLICAR.md", "VERSION"):
        if (kit / n).is_file():
            shutil.copy2(kit / n, destino / n)
            sueltos.append(destino / n)
    (destino / "SHA256SUMS").write_text(
        "".join("%s  %s\n" % (_sha256(p), p.name) for p in sueltos), encoding="utf-8")

    print("Paquete %s en %s" % (version, destino))
    for p in sorted(destino.iterdir(), key=lambda x: x.name):
        if p.is_file():
            print("  %-28s %8d B  %s" % (p.name, p.stat().st_size, _sha256(p)[:16]))
    print("\n%d ficheros empaquetados. Publica el contenido de %s en una URL y reparte la orden:"
          % (len(ficheros), destino))
    print("\n  curl -fsSL https://TU-DOMINIO/install.sh | sh -s -- --dir mi-obra "
          "--titulo \"Mi obra\" --capitulos 20 --objetivo 60000")
    print("\nVer PUBLICAR.md (cuatro formas) y `nk distribuir` (bundle + hoja de entrega).")
    return 0


def cmd_distribuir(args):
    """Paquete + git bundle + hoja de instrucciones: entrega sin publicar nada."""
    import subprocess
    kit = Path(__file__).resolve().parent.parent
    destino = Path(args.destino or (kit / "dist"))
    cmd_paquete(argparse.Namespace(destino=str(destino)))
    version = (kit / "VERSION").read_text(encoding="utf-8").strip() \
        if (kit / "VERSION").is_file() else VERSION
    nombre = "novela-kit-%s" % version

    bundle = destino / (nombre + ".bundle")
    es_repo = (kit / ".git").exists()
    if es_repo and shutil.which("git"):
        if bundle.exists():
            bundle.unlink()
        subprocess.run(["git", "-C", str(kit), "bundle", "create", str(bundle), "--all"],
                       check=True, capture_output=True, text=True)
        ver = subprocess.run(["git", "bundle", "verify", str(bundle)],
                             capture_output=True, text=True)
        if ver.returncode != 0:
            raise NKError("el bundle no verifica: %s" % ver.stderr.strip())
        ramas = subprocess.run(["git", "-C", str(kit), "rev-list", "--count", "--all"],
                               capture_output=True, text=True).stdout.strip()
        print("Bundle: %s (%s commits, verificado)" % (bundle.name, ramas))
    else:
        bundle = None
        print("Aviso: sin repositorio git; no se genera bundle." if not es_repo
              else "Aviso: git no está instalado; no se genera bundle.")

    hoja = destino / "COMO-DARLO.md"
    hoja.write_text(hoja_entrega(kit, destino, version, bundle), encoding="utf-8")

    sueltos = [p for p in sorted(destino.iterdir(), key=lambda x: x.name)
               if p.is_file() and p.name != "SHA256SUMS"]
    (destino / "SHA256SUMS").write_text(
        "".join("%s  %s\n" % (_sha256(p), p.name) for p in sueltos), encoding="utf-8")
    print("\n%d ficheros en %s, con SHA256SUMS al día." % (len(sueltos), destino))
    print("Instrucciones para el agente: %s" % hoja)
    return 0


def hoja_entrega(kit, destino, version, bundle):
    d = str(destino)
    tar = "novela-kit-%s.tar.gz" % version
    b = bundle.name if bundle else "(sin bundle: este directorio no es un repositorio git)"
    return """# Cómo entregar esto a un agente (sin publicar nada)

Generado por `nk distribuir`. Versión %(v)s. Directorio: `%(d)s`.

Este paquete **no se ha subido a ninguna parte**: no hay remoto, ni URL pública, ni release. Todo se
entrega por fichero local, que es lo que permite dárselo a un agente hoy y publicarlo cuando se
quiera.

## A. Solo lectura: un fichero

El agente lee `PROTOCOLO.md` y construye el árbol él mismo. No ejecuta código.

```
curl -fsSL file://%(d)s/PROTOCOLO.md -o PROTOCOLO.md
```

Si el agente no puede leer rutas locales, se le pega el contenido (`cat PROTOCOLO.md`) o se le pasa
el fichero por el canal que uses.

## B. Instalación por `curl` local (sin servidor)

`curl` acepta `file://`, así que no hace falta levantar nada:

```
curl -fsSL file://%(d)s/install.sh | sh -s -- \
  --base file://%(d)s \
  --dir mi-obra --titulo "Mi obra" --autor "Quien firma" \
  --partes 2 --capitulos 20 --objetivo 60000
```

Comprueba el SHA-256 y deja la obra con el kit dentro. Si el agente corre en otra máquina o en un
sandbox sin acceso a tu disco, usa C o D.

## C. Repositorio completo por bundle (historial incluido)

Un `.bundle` **es un repositorio**: se clona como si estuviera en un servidor, sin subirlo a
ninguno.

```
git clone %(d)s/%(b)s novela-kit
cd novela-kit
git log --oneline          # historial completo
git bundle verify %(d)s/%(b)s
bin/nk --version
```

Y desde ahí, la obra:

```
bin/nk init ../mi-obra --titulo "Mi obra" --partes 2 --capitulos 20 --objetivo 60000
```

Ventaja frente al tarball: el agente ve el historial, las decisiones y las pruebas; puede comparar y
revertir. Se puede firmar y verificar con GPG si hace falta.

## D. Servidor local (para otro ordenador o un sandbox con red)

```
cd %(d)s && python3 -m http.server 8080
```

Y en el otro lado, la orden de B cambiando `file://$(d)s` por `http://IP-DEL-ORDENADOR:8080`.

## E. Cuando sí se quiera publicar (más adelante)

El repo ya está preparado: `.gitignore`, `.gitattributes`, `LICENSE-CODIGO`, `LICENSE-TEXTO`,
`.github/workflows/pruebas.yml`. Sin nada que limpiar a mano.

```
gh repo create novela-kit --public --source . --push   # requiere decidirlo antes
```

O, sin `gh`: crear el repo vacío en la web, `git remote add origin …` y `git push -u origin main`.
Un repositorio local **no es un respaldo**: el bundle sí sirve como copia.

## F. Si lo que se entrega es una obra que ya existe

No hace falta instalar nada: la obra lleva el kit dentro (`escritura/`). Se empaqueta su historial y
se clona igual:

```
cd /ruta/a/la-obra && git bundle create /tmp/obra.bundle --all
git clone /tmp/obra.bundle /tmp/obra
cd /tmp/obra && escritura/bin/nk estado && escritura/bin/nk contar
```

Y si la obra aún no lleva el kit, se instala uno nuevo y se copian encima `APUNTES.md`, `SINOPSIS/`,
`ESTUDIOS/`, `MANUSCRITO/` y `libro.json`: el manifiesto manda los números.

## Qué pegarle al agente

> Tienes el kit en `%(d)s` (o clonado de `%(b)s`). Lee `PROTOCOLO.md` y `AGENTS.md`.
> Instala la obra con la orden de `COMO-DARLO.md` apartado B, o construye el árbol siguiendo
> `PROTOCOLO.md` §2-§3 si no puedes ejecutar código.
> Después: `bin/nk andamiaje`, `bin/nk nuevo I.1 --titulo "Primer capítulo"` y escribe el capítulo
> según el presupuesto. Antes de dármelo: `bin/nk verificar --rubrica`.
> No inventes canon, ni nombres, ni cifras. No publiques nada.

## Aviso

`%(tar)s` es reproducible: dos `nk paquete` seguidos dan el mismo SHA-256. Cualquier cambio en el
paquete se ve en `SHA256SUMS`. Un agente debe revisar `install.sh` antes de ejecutarlo, aunque sea
local.
""" % {"v": version, "d": d, "b": b, "tar": tar}


def _slug(texto):
    import unicodedata
    t = unicodedata.normalize("NFD", texto or "obra")
    t = "".join(c for c in t if unicodedata.category(c) != "Mn")
    t = re.sub(r"[^a-zA-Z0-9]+", "-", t).strip("-").lower()
    return t or "obra"


def cmd_respaldo(args):
    """Copia de seguridad en un medio externo: bundle de git + (opcional) materiales."""
    import subprocess
    r, man = cargar(args.libro)
    destino = Path(args.destino).expanduser()
    if not destino.is_dir():
        raise NKError("no existe el directorio de destino: %s" % destino)
    if not (r / ".git").exists():
        raise NKError("la raíz de la obra no es un repositorio git: %s" % r)
    if not shutil.which("git"):
        raise NKError("hace falta git para crear el bundle")
    libres = shutil.disk_usage(destino).free
    if libres < 20 * 1024 * 1024:
        raise NKError("quedan menos de 20 MB libres en %s" % destino)

    fecha = date.today().isoformat()
    etiqueta = args.etiqueta or ("v" + (args.version or VERSION))
    base = "%s-%s-%s" % (_slug(man["libro"].get("titulo")), fecha, etiqueta)
    bundle = destino / (base + ".bundle")
    subprocess.run(["git", "-C", str(r), "bundle", "create", str(bundle), "--all"],
                   check=True, capture_output=True, text=True)
    ver = subprocess.run(["git", "bundle", "verify", str(bundle)],
                         capture_output=True, text=True)
    if ver.returncode != 0:
        raise NKError("el bundle no verifica: %s" % ver.stderr.strip())
    commits = subprocess.run(["git", "-C", str(r), "rev-list", "--count", "--all"],
                             capture_output=True, text=True).stdout.strip()
    print("Bundle: %s (%s commits, verificado)" % (bundle.name, commits))

    sumas = ["%s  %s" % (_sha256(bundle), bundle.name)]
    materiales = Path(args.materiales).expanduser() if args.materiales else None
    if materiales:
        if not materiales.is_dir():
            raise NKError("no existe el directorio de materiales: %s" % materiales)
        import tarfile
        tgz = destino / (base + "-materiales.tar.gz")
        ficheros = sorted(p for p in materiales.rglob("*")
                          if p.is_file() and "__pycache__" not in p.parts)
        with tarfile.open(tgz, "w:gz") as tf:
            for f in ficheros:
                tf.add(f, arcname=str(Path(materiales.name) / f.relative_to(materiales)))
        sumas.append("%s  %s" % (_sha256(tgz), tgz.name))
        print("Materiales: %s (%d ficheros)" % (tgz.name, len(ficheros)))
    (destino / (base + ".sha256")).write_text("\n".join(sumas) + "\n", encoding="utf-8")
    print("Hashes: %s.sha256" % base)
    print("\nPara restaurar en cualquier máquina:\n")
    print("  git clone %s obra && cd obra" % bundle.name)
    print("  escritura/bin/nk estado\n" if (r / "escritura").is_dir()
          else "  bin/nk estado\n")
    print("Un repositorio local no es un respaldo: esto sí.")
    return 0


# --------------------------------------------------------------------------- #
# main
# --------------------------------------------------------------------------- #

def main(argv=None):
    p = argparse.ArgumentParser(prog="nk", description="novela-kit")
    p.add_argument("--version", action="version", version="nk " + VERSION)
    p.add_argument("--libro", help="raíz de la obra (por defecto, se busca libro.json)")
    sub = p.add_subparsers(dest="cmd")

    sub.add_parser("estado", help="dónde estamos y qué toca").set_defaults(func=cmd_estado)
    sub.add_parser("andamiaje", help="crea directorios y huecos").set_defaults(func=cmd_andamiaje)

    c = sub.add_parser("contar", help="recuento y desviación")
    c.add_argument("capitulo", nargs="?")
    c.add_argument("--todo", action="store_true", help="incluye capítulos pendientes")
    c.add_argument("--actualizar", action="store_true", help="reescribe el bloque de ESTRUCTURA.md")
    c.add_argument("--json", action="store_true")
    c.add_argument("--wc", action="store_true", help="compara con `wc -w`")
    c.set_defaults(func=cmd_contar)

    n = sub.add_parser("nuevo", help="abre un capítulo vacío")
    n.add_argument("capitulo")
    n.add_argument("--titulo")
    n.add_argument("--desde", help="sinopsis o estudio de origen")
    n.add_argument("--forzar", action="store_true")
    n.set_defaults(func=cmd_nuevo)

    v = sub.add_parser("verificar", help="invariantes del método")
    v.add_argument("--rubrica", action="store_true", help="añade la rúbrica de voz")
    v.set_defaults(func=cmd_verificar)

    i = sub.add_parser("informe", help="estado.json legible por máquina")
    i.add_argument("--salida")
    i.set_defaults(func=cmd_informe)

    e = sub.add_parser("exportar", help="EPUB 3 o Markdown combinado")
    e.add_argument("-f", "--formato", choices=["epub", "md"], default="epub")
    e.add_argument("--salida")
    e.set_defaults(func=cmd_exportar)

    sub.add_parser("canon", help="lista y comprueba el canon").set_defaults(func=cmd_canon)

    ini = sub.add_parser("init", help="nueva obra a partir de la plantilla")
    ini.add_argument("directorio")
    ini.add_argument("--titulo", required=True)
    ini.add_argument("--autor", default="")
    ini.add_argument("--fuente", default="")
    ini.add_argument("--partes", type=int, default=2)
    ini.add_argument("--capitulos", type=int, default=20)
    ini.add_argument("--objetivo", type=int, default=60000)
    ini.add_argument("--forzar", action="store_true")
    ini.set_defaults(func=cmd_init)

    pa = sub.add_parser("paquete", help="tarball reproducible, hashes e instalador")
    pa.add_argument("--destino", help="directorio de salida (por defecto dist/)")
    pa.set_defaults(func=cmd_paquete)

    di = sub.add_parser("distribuir",
                        help="paquete + bundle de git + hoja de entrega (sin publicar)")
    di.add_argument("--destino", help="directorio de salida (por defecto dist/)")
    di.set_defaults(func=cmd_distribuir)

    re_ = sub.add_parser("respaldo", help="bundle de git (+ materiales) en un medio externo")
    re_.add_argument("--destino", required=True, help="USB o directorio de copia")
    re_.add_argument("--etiqueta", help="sufijo de la copia (por defecto vVERSION)")
    re_.add_argument("--version", help="versión para el nombre")
    re_.add_argument("--materiales", help="directorio de materiales a empaquetar aparte")
    re_.set_defaults(func=cmd_respaldo)

    args = p.parse_args(argv)
    if not getattr(args, "func", None):
        p.print_help()
        return 2
    try:
        return args.func(args)
    except NKError as exc:
        print("nk: %s" % exc, file=sys.stderr)
        return 2
    except BrokenPipeError:
        return 0


if __name__ == "__main__":
    sys.exit(main())
